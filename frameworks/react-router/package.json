{
  "name": "optiview-react-router-sample",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "copy:theoplayer": "node scripts/copy-theoplayer.mjs",
    "predev": "npm run copy:theoplayer",
    "dev": "react-router dev",
    "prebuild": "npm run copy:theoplayer",
    "build": "react-router typegen && tsc --noEmit && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "npm run start"
  },
  "dependencies": {
    "theoplayer": "^11",
    "@theoplayer/react-ui": "^2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^24"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
