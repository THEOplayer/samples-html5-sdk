{
  "name": "optiview-sveltekit-sample",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "copy:theoplayer": "node scripts/copy-theoplayer.mjs",
    "predev": "npm run copy:theoplayer",
    "dev": "vite dev",
    "prebuild": "npm run copy:theoplayer",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@theoplayer/web-ui": "^2",
    "svelte": "^5.58.0",
    "theoplayer": "^11"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "fsevents": false
  }
}
