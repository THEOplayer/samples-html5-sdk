{
  "name": "com.theoplayer.lightning",
  "description": "OptiView Player Lightning example",
  "private": true,
  "dependencies": {
    "@lightningjs/sdk": "^5.5.7",
    "theoplayer": "^11"
  },
  "scripts": {
    "postinstall": "npm run copy:theoplayer",
    "copy:theoplayer": "node scripts/copy-theoplayer.mjs",
    "build": "lng build",
    "serve": "http-server build -a localhost -p 8080 -c-1 -o",
    "watch": "lng watch",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lightningjs/cli": "^2.14.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "html-encoding-sniffer": "^7",
    "lodash": "^4.17.24",
    "merge": "^2.1.1",
    "serialize-javascript": "^7.1.3",
    "tmp": "^0.2.6",
    "moment": "^2.30.2",
    "got": "^11.8.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "@lightningjs/sdk": true,
    "core-js": false,
    "esbuild": false,
    "fsevents": false
  }
}
